{
  "$defs": {
    "Count": {
      "additionalProperties": false,
      "properties": {
        "number": {
          "maximum": 99,
          "minimum": 0,
          "title": "Number",
          "type": "integer"
        },
        "votes": {
          "maximum": 1000000000,
          "minimum": 0,
          "title": "Votes",
          "type": "integer"
        }
      },
      "required": [
        "number",
        "votes"
      ],
      "title": "Count",
      "type": "object"
    },
    "Election": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "school": {
          "maxLength": 180,
          "title": "School",
          "type": "string"
        },
        "public_url": {
          "maxLength": 160,
          "title": "Public Url",
          "type": "string"
        },
        "identified": {
          "title": "Identified",
          "type": "boolean"
        },
        "registered": {
          "anyOf": [
            {
              "maximum": 1000000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Registered"
        },
        "allow_blank": {
          "title": "Allow Blank",
          "type": "boolean"
        },
        "sealed_at": {
          "title": "Sealed At",
          "type": "string"
        },
        "config_hash": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Config Hash",
          "type": "string"
        },
        "slates": {
          "items": {
            "$ref": "#/$defs/Slate"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Slates",
          "type": "array"
        },
        "urns": {
          "items": {
            "$ref": "#/$defs/Urn"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Urns",
          "type": "array"
        }
      },
      "required": [
        "id",
        "name",
        "school",
        "public_url",
        "identified",
        "allow_blank",
        "sealed_at",
        "config_hash",
        "slates",
        "urns"
      ],
      "title": "Election",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "software_version": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Software Version",
          "type": "string"
        },
        "zero_issued_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Zero Issued At"
        },
        "opened_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Opened At"
        },
        "closed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Closed At"
        },
        "zero_snapshot_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Zero Snapshot Hash"
        },
        "ballot_set_hash": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Ballot Set Hash"
        }
      },
      "required": [
        "software_version",
        "zero_issued_at",
        "opened_at",
        "closed_at",
        "zero_snapshot_hash",
        "ballot_set_hash"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Member": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "name": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "role",
        "name"
      ],
      "title": "Member",
      "type": "object"
    },
    "Slate": {
      "additionalProperties": false,
      "properties": {
        "number": {
          "maximum": 99,
          "minimum": 0,
          "title": "Number",
          "type": "integer"
        },
        "name": {
          "maxLength": 150,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/Member"
          },
          "maxItems": 100,
          "title": "Members",
          "type": "array"
        },
        "photo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Photo"
        }
      },
      "required": [
        "number",
        "name",
        "members"
      ],
      "title": "Slate",
      "type": "object"
    },
    "Totals": {
      "additionalProperties": false,
      "properties": {
        "registered": {
          "anyOf": [
            {
              "maximum": 1000000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Registered"
        },
        "slates": {
          "items": {
            "$ref": "#/$defs/Count"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Slates",
          "type": "array"
        },
        "blank": {
          "maximum": 1000000000,
          "minimum": 0,
          "title": "Blank",
          "type": "integer"
        },
        "null": {
          "maximum": 1000000000,
          "minimum": 0,
          "title": "Null",
          "type": "integer"
        },
        "total": {
          "maximum": 1000000000,
          "minimum": 0,
          "title": "Total",
          "type": "integer"
        },
        "attendance": {
          "anyOf": [
            {
              "maximum": 1000000000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Attendance"
        }
      },
      "required": [
        "registered",
        "slates",
        "blank",
        "null",
        "total",
        "attendance"
      ],
      "title": "Totals",
      "type": "object"
    },
    "Urn": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "code": {
          "maxLength": 20,
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "name": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "id",
        "code",
        "name"
      ],
      "title": "Urn",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "kind": {
      "enum": [
        "configuration",
        "zero",
        "result"
      ],
      "title": "Kind",
      "type": "string"
    },
    "revision": {
      "maximum": 10000,
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "previous": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous"
    },
    "correction": {
      "default": "",
      "maxLength": 500,
      "title": "Correction",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "election": {
      "$ref": "#/$defs/Election"
    },
    "urn_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Urn Id"
    },
    "configuration_digest": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Configuration Digest"
    },
    "totals": {
      "anyOf": [
        {
          "$ref": "#/$defs/Totals"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence": {
      "$ref": "#/$defs/Evidence"
    }
  },
  "required": [
    "schema_version",
    "id",
    "kind",
    "revision",
    "created_at",
    "election",
    "urn_id",
    "totals",
    "evidence"
  ],
  "title": "Document",
  "type": "object"
}
